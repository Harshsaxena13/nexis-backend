{
  "name": "nexis-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Text-only chat backend for the Nexis AI voice agent (Groq).",
  "type": "module",
  "engines": {
    "node": ">=22.9 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "groq-sdk": "^1.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
