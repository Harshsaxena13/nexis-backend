# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Required. Create one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Best Hinglish and most honest in testing (~0.6 s). openai/gpt-oss-20b is faster but invents facts more.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=15000
GROQ_MAX_RETRIES=1
# Includes the model's (low-effort) reasoning tokens, so keep some headroom.
MAX_COMPLETION_TOKENS=900
MAX_REPLY_CHARS=500

# How Hinglish replies are written: devanagari (Hindi in Devanagari, English in Latin; best for
# Hindi TTS voices) or roman (all Latin script).
HINGLISH_SCRIPT=devanagari

# Hosts like Render set PORT themselves; don't set it there.
PORT=8787
# 0.0.0.0 lets a phone on the same Wi-Fi reach the dev server. Render requires it.
HOST=0.0.0.0

# Per client IP, per minute.
RATE_LIMIT_PER_MINUTE=20
CONTEXT_MAX_MESSAGES=12
SESSION_TTL_MINUTES=30
MAX_SESSIONS=1000

# Optional: if set, the app must send it as the x-nexis-client-key header (min 16 chars).
# This only deters casual abuse; anything shipped in an app can be extracted.
# CLIENT_API_KEY=

# Set to 1 when running behind one reverse proxy (Fly, Nginx) so rate limits see real IPs.
# Defaults to 1 on Render.
# TRUST_PROXY=1

# Logs transcripts and replies when true. Off by default for privacy.
LOG_USER_TEXT=false
